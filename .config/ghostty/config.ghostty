
theme = Catppuccin Mocha

# --- Fonts
# font-family = "JetBrainsMono Nerd Font Mono"
font-family = "Maple Mono"
font-size = 12
# --- Window / Appearance
window-padding-x = 0
window-padding-y = 0
window-padding-balance

# Hyprland does the blurring (decoration:blur). background-blur is macOS/KDE
# only and is ignored on Wayland/Hyprland, so it is intentionally not set.
background-opacity = 0.95

# refresh with: ctrl+shift+, (M key in querty)


# --- Custom Shader (cursor trail like kitty)
custom-shader = shaders/cursor-smear.glsl
custom-shader-animation = always
window-decoration = auto
macos-titlebar-style = hidden
confirm-close-surface = false
